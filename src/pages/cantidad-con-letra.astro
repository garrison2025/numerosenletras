---
import Layout from '../layouts/Layout.astro';
import QuantityWithLetter from '../components/QuantityWithLetter';

const title = "Convertir Cantidades a Letras | Generador para Cheques y Facturas";
const description = "Escribe cualquier cantidad de dinero en letras de forma correcta. Compatible con pesos, dólares, euros y más. Genera el formato formal para rellenar cheques y recibos.";
const keywords = "cantidad con letra, números a letras, cheques en letras, facturas con letra, escribir cantidades, convertidor de dinero, pesos a letras";

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cantidad con Letra - Generador de Cheques y Facturas",
    "url": "https://numerosenletras.org/cantidad-con-letra",
    "description": description,
    "applicationCategory": "FinancialApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript. Requires HTML5."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Cómo poner la cantidad en letras en un cheque o pagaré?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Escribe el monto en nuestro generador, selecciona la moneda de tu país (MXN, USD, EUR, COP, PEN, etc.) y copia la frase formateada directamente en tu documento, factura o cheque bancario."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cómo se representan los centavos al redactar una cifra de dinero?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "En documentos bancarios se expresa habitualmente con la fracción sobre cien (ej. 00/100 M.N. o 50/100 USD), para certificar formalmente que no existen fracciones decimales ambiguas."
        }
      }
    ]
  }
];
const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Cantidad con Letra", path: "/cantidad-con-letra" }
];
---

<Layout title={title} description={description} keywords={keywords} currentPath="/cantidad-con-letra" schemaData={schemaData} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto px-4 mt-6 sm:mt-10">
    <QuantityWithLetter client:load />
  </div>
</Layout>
