---
import Layout from '../layouts/Layout.astro';
import { PrivacyPolicy } from '../components/LegalPages';

const title = "Política de Privacidad | numerosenletras.org";
const description = "Consulta nuestra política de privacidad. Garantizamos seguridad total: no almacenamos datos en servidores externos; todo se ejecuta localmente.";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Política de Privacidad | numerosenletras.org",
  "url": "https://numerosenletras.org/privacidad",
  "description": description
};
---

<Layout title={title} description={description} currentPath="/privacidad" schemaData={schemaData}>
  <PrivacyPolicy client:load />
</Layout>
